# Copy to .env. quickstart.sh generates this file automatically with fresh keys.

# REQUIRED — at-rest encryption for provider secrets + tenant key bootstrap.
# Generate: openssl rand -base64 32
MASKCHAIN_KEYS_KEY=

# Only needed if you later enable conversations.enabled in config-base.yaml.
# Generate: openssl rand -base64 32
MASKCHAIN_CONVERSATION_KEY=

# Only for the OpenAI path (docker-compose.openai.yml).
OPENAI_KEY=

# Optional: override the Ollama model pulled on startup (default: llama3.2).
# OLLAMA_MODEL=llama3.2
