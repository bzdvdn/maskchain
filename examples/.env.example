# Provider API keys
OPENAI_KEY=<YOUR_OPENAI_API_KEY>
MISTRAL_KEY=<YOUR_MISTRAL_API_KEY>
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GROQ_API_KEY=<YOUR_GROQ_API_KEY>
YANDEX_AI_KEY=<YOUR_YANDEX_AI_KEY>

# AWS Bedrock (optional, falls back to env/IAM if empty)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Admin credentials (overrides config-runtime.yaml)
ADMIN_PASSWORD=test

# --- REQUIRED with DB-backed routing/tenancy ---

# At-rest encryption key for provider secrets (routing.providers[*].api_keys, aws_*).
# REQUIRED: service fails closed without it when DB routing/tenancy is enabled.
# 32 random bytes, base64. Generate: openssl rand -base64 32
MASKCHAIN_KEYS_KEY=<YOUR_32_BYTE_BASE64_KEY>

# Conversation logging encryption key (conversations.enabled=true): 32 random bytes, base64
# Generate: openssl rand -base64 32
MASKCHAIN_CONVERSATION_KEY=<YOUR_32_BYTE_BASE64_KEY>

# Optional: if your deployment config uses ${DEFAULT_API_KEY}, set a raw tenant
# key here — it is bootstrapped into a SHA-256-hashed virtual key on startup.
DEFAULT_API_KEY=<YOUR_DEFAULT_TENANT_KEY>
